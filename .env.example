# Copy to .env and fill in your own values. .env is gitignored.
# Find your bus stop's TimingPointCode at http://v0.ovapi.nl/line/

TZ=Europe/Amsterdam

# Bus: one or more OVapi TimingPointCodes (comma-separated), how many minutes
# before departure you need to leave home (walk + buffer), and how many
# departures to show.
DASH_BUS_TPC=37400110
DASH_WALK_OFFSET_MIN=8
DASH_MAX_DEPARTURES=4

# Waste collection address (Opzet afvalkalender).
DASH_POSTCODE=1011AB
DASH_HOUSE_NUMBER=1

# Weather location (Open-Meteo).
DASH_LAT=52.3731
DASH_LON=4.8922

# Cadences (optional).
DASH_REFRESH_SECONDS=60
DASH_BUS_POLL_SECONDS=30
DASH_TRASH_POLL_HOURS=6
DASH_TRASH_WEEKS=4
DASH_WEATHER_POLL_MIN=15
